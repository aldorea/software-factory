{
  "name": "software-factory",
  "private": true,
  "type": "module",
  "bin": {
    "factory": "./src/cli/factory.ts"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "factory": "node src/cli/factory.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/client",
    "test": "vitest run",
    "test:docker": "FACTORY_DOCKER_TESTS=1 vitest run --no-file-parallelism test/docker",
    "image:build": "docker build -t software-factory/worker:dev --build-arg AGENT_UID=$(id -u) --build-arg AGENT_GID=$(id -g) docker",
    "build:web": "vite build --config src/web/client/vite.config.ts",
    "web:dev": "vite --config src/web/client/vite.config.ts",
    "postinstall": "pnpm build:web"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^3.2.7"
  }
}
