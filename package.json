{
  "name": "software-factory",
  "private": true,
  "type": "module",
  "bin": {
    "factory": "./src/cli/factory.ts"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "factory": "node src/cli/factory.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:docker": "FACTORY_DOCKER_TESTS=1 vitest run --no-file-parallelism test/docker",
    "image:build": "docker build -t software-factory/worker:dev --build-arg AGENT_UID=$(id -u) --build-arg AGENT_GID=$(id -g) docker"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
